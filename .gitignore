# Build artefacts
build/
dist/
__pycache__/
*.pyc

# Local setup state - contains your registry/repo choices, never published.
setup-state.json

# Personal notes. This README documents findings and decisions for the
# operator; it is not intended for other readers of the repo.
README.md

# NOTE: the following are deliberately NOT ignored, because BlueBuild needs
# them to build the image from this repo:
#   Containerfile        - the image definition (regenerated by build.py)
#   blueprint.yml        - BlueBuild config (written by setup.py phase1)
#   .github/workflows/   - the CI workflow (written by setup.py phase1)
# If you change the registry/repo name, re-run ./setup.py phase1 and re-push.

# Dropped by the BlueBuild CLI when rendering a recipe locally
.bluebuild-scripts_*

# Never commit signing keys. cosign.pub IS committed (verifiers need it);
# the private half must never enter the repo.
cosign.key
cosign.private

/.bluebuild-scripts_*
