[Unit]
Description=Daily check for Caelestia OSTree updates
Documentation=https://github.com/lovel33t/caelestia-fedora

[Timer]
# 00:00 local time - systemd's OnCalendar is local, not UTC.
OnCalendar=*-*-* 00:00:00
# Catch up after the machine has been off, without hammering the registry.
Persistent=true
RandomizedDelaySec=20m

[Install]
WantedBy=timers.target
