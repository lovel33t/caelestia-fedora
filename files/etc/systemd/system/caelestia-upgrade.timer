[Unit]
Description=Check for Caelestia OSTree updates twice a day
Documentation=https://github.com/lovel33t/caelestia-fedora

[Timer]
OnCalendar=*-*-* 04,16:30:00
# Catch up after the machine has been off, without hammering the registry.
Persistent=true
RandomizedDelaySec=30m

[Install]
WantedBy=timers.target
