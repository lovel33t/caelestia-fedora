[Unit]
Description=Caelestia first-boot provisioning
DefaultDependencies=no
After=local-fs.target systemd-user-sessions.service
Before=display-manager.service sshd.service
ConditionPathExists=!/var/lib/caelestia/provisioned

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/caelestia-firstboot

[Install]
WantedBy=multi-user.target