#!/usr/bin/env bash
# caelestia-update - check for and apply updates to this Caelestia image.
#
# It works out which image it is from the ostree remote that
# caelestia-firstboot.service configured, so the same script is correct on
# the NVIDIA image and on the non-NVIDIA one without being told which.
#
#   caelestia-update            check, and upgrade if something is newer
#   caelestia-update --check    only report, never change anything
#   caelestia-update --reboot   upgrade and reboot once staged
#   caelestia-update --status   what is deployed right now
set -euo pipefail

REMOTE_CONF=/etc/ostree/remotes.d/caelestia.conf

die()  { printf 'error: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }

CHECK_ONLY=0
REBOOT=0
STATUS_ONLY=0
for arg in "$@"; do
    case "$arg" in
        --check)  CHECK_ONLY=1 ;;
        --reboot) REBOOT=1 ;;
        --status) STATUS_ONLY=1 ;;
        -h|--help) sed -n '2,16p' "$0"; exit 0 ;;
        *) die "unknown option: $arg" ;;
    esac
done

[ -r "$REMOTE_CONF" ] || die "no ostree remote at $REMOTE_CONF - the image is not provisioned"

# The remote already carries the right registry path for this variant, e.g.
# ostree-image-signed:docker://ghcr.io/lovel33t/caelestia-fedora:latest
URL=$(awk -F= '/^url=/ {sub(/^url=/,""); print; exit}' "$REMOTE_CONF")
REF=${URL##*://}
REPO_PATH=${REF%%:*}
NAMESPACE=${REPO_PATH%%/*}
NAME=${REPO_PATH#*/}

[ -n "$NAME" ] || die "could not parse an image from $URL"

# Digest of what is booted right now.
current_digest() {
    rpm-ostree status -b --json 2>/dev/null \
        | jq -r '.deployments[0]["container-image-reference-digest"] // empty'
}

# An image ref resolves to a multi-arch index, whose digest is NOT what gets
# deployed: rpm-ostree picks the child matching this machine and records THAT
# digest. Comparing the deployed digest against the index would report a
# spurious update every single run. So we resolve the index down to the
# platform child first, and show both digests so the difference is obvious.
ARCH="$(uname -m)"
case "$ARCH" in
    x86_64)  GOARCH=amd64; GOOS=linux ;;
    aarch64) GOARCH=arm64; GOOS=linux ;;
    *)       GOARCH="$ARCH"; GOOS=linux ;;
esac

ghcr_token() {
    curl -sS --retry 3 \
        "https://ghcr.io/token?scope=repository:$NAMESPACE/$NAME:pull&service=ghcr.io" \
        | jq -r '.token // empty'
}

ACCEPT='application/vnd.oci.image.index.v1+json,application/vnd.oci.image.manifest.v1+json'

# Prints: "<index-digest> <platform-digest>"; platform may equal the index.
remote_digests() {
    local token index child
    token=$(ghcr_token)
    [ -n "$token" ] || return 1

    index=$(curl -sSI --retry 3 -H "Authorization: Bearer $token" -H "Accept: $ACCEPT" \
        "https://ghcr.io/v2/$NAMESPACE/$NAME/manifests/latest" \
        | tr -d '\r' | awk 'tolower($1)=="docker-content-digest:" {print $2}')
    [ -n "$index" ] || return 1

    # A single-arch image is already the platform manifest.
    child=$(curl -sS --retry 3 -H "Authorization: Bearer $token" -H "Accept: $ACCEPT" \
        "https://ghcr.io/v2/$NAMESPACE/$NAME/manifests/$index" 2>/dev/null \
        | jq -r --arg a "$GOARCH" --arg o "$GOOS" \
            '[.manifests[]? | select(.platform.os == $o and .platform.architecture == $a) | .digest][0] // empty' 2>/dev/null)

    printf '%s %s\n' "$index" "${child:-$index}"
}

deployed_version() {
    rpm-ostree status -b --json 2>/dev/null \
        | jq -r '.deployments[0].version // "unknown"'
}

info "image   : $NAMESPACE/$NAME"

if [ "$STATUS_ONLY" = 1 ]; then
    info "version : $(deployed_version)"
    info "deployed: $(current_digest)"
    exit 0
fi

read -r INDEX_DIGEST REMOTE <<<"$(remote_digests || true)"
[ -n "$REMOTE" ] || die "could not reach the registry for $NAMESPACE/$NAME"
CURRENT=$(current_digest)
[ -n "$CURRENT" ] || die "could not determine the deployed image digest"

info "version : $(deployed_version)"
info "index   : $INDEX_DIGEST   (what the tag points at)"
info "platform: $REMOTE   ($GOOS/$GOARCH - what is actually deployed)"
info "deployed: $CURRENT"

# Compare platform-to-platform. The index digest is informational only.
if [ "$REMOTE" = "$CURRENT" ]; then
    info "up to date"
    exit 0
fi

info "an update is available"

if [ "$CHECK_ONLY" = 1 ]; then
    exit 0
fi

# Nothing has been staged yet; `upgrade` resolves the remote and stages it.
if rpm-ostree upgrade; then
    info "staged. reboot to apply:"
    info "  systemctl reboot"
    if [ "$REBOOT" = 1 ]; then
        info "rebooting..."
        systemctl reboot
    fi
else
    info "nothing to apply"
    exit 1
fi
